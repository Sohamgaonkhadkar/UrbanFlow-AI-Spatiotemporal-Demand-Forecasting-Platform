{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm ci --prefix frontend && npm run build --prefix frontend",
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "excludeFiles": "{backend/tests/**,docs/**,frontend/node_modules/**,frontend/src/**,frontend/tests/**,.venv/**,**/__pycache__/**}"
    }
  }
}
